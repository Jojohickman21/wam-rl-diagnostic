<!--
  xArm 7 without gripper, from google-deepmind/mujoco_menagerie ufactory_xarm7/xarm7_nohand.xml
  at commit 370c43965323c0944b433b202aac5058b5f907a9. Kinematics, inertias, joint and actuator
  parameters are unchanged. Differences from upstream:
    - meshes are visual only (class "visual"); upstream collides with their convex hulls
    - capsule/cylinder collision geoms (class "collision") on every link
    - arm geoms have conaffinity=0, so the arm does not collide with itself
    - a plate held by its rim on link7 stands in for the gripper's primary task
    - the unused link7.stl mesh asset is dropped
    - base body sits at z=0 instead of 0.12; compiler, option and keyframe live in the scene
      file, so this file loads only through an include
-->
<mujoco model="xarm7 wam">
  <asset>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.753 0.753 0.753 1"/>
    <material name="plate" rgba="0.2 0.45 0.8 1"/>

    <mesh file="link_base.stl"/>
    <mesh file="link1.stl"/>
    <mesh file="link2.stl"/>
    <mesh file="link3.stl"/>
    <mesh file="link4.stl"/>
    <mesh file="link5.stl"/>
    <mesh file="link6.stl"/>
    <mesh file="end_tool.stl"/>
  </asset>

  <default>
    <default class="xarm7">
      <joint axis="0 0 1" armature="0.1" range="-6.28319 6.28319" frictionloss="1"/>
      <general biastype="affine" ctrlrange="-6.28319 6.28319"/>
      <default class="size1">
        <joint damping="10"/>
        <general gainprm="1500" biasprm="0 -1500 -150" forcerange="-50 50"/>
      </default>
      <default class="size2">
        <joint damping="5"/>
        <general gainprm="1000" biasprm="0 -1000 -100" forcerange="-30 30"/>
      </default>
      <default class="size3">
        <joint damping="2"/>
        <general gainprm="800" biasprm="0 -800 -80" forcerange="-20 20"/>
      </default>
      <default class="visual">
        <geom type="mesh" material="white" contype="0" conaffinity="0" group="2" mass="0"/>
      </default>
      <default class="collision">
        <!-- solref timeconst must stay >= 2*timestep (0.002 at dt=0.001) -->
        <geom type="capsule" contype="1" conaffinity="0" group="3" mass="0" rgba="0.9 0.3 0.3 0.4"
          condim="3" friction="0.5 0.005 0.0001" solref="0.002 1" solimp="0.95 0.99 0.001 0.5 2"/>
      </default>
      <site size="0.001" rgba="1 0 0 1" group="4"/>
    </default>
  </default>

  <worldbody>
    <body name="link_base" childclass="xarm7">
      <inertial pos="-0.021131 -0.0016302 0.056488" quat="0.696843 0.20176 0.10388 0.680376" mass="0.88556"
        diaginertia="0.00382023 0.00335282 0.00167725"/>
      <geom class="visual" mesh="link_base"/>
      <geom class="collision" type="cylinder" size="0.063 0.0775" pos="0 0 0.0775"/>
      <body name="link1" pos="0 0 0.267">
        <inertial pos="-0.0002 0.02905 -0.01233" quat="0.978953 -0.202769 -0.00441617 -0.0227264" mass="2.382"
          diaginertia="0.00569127 0.00533384 0.00293865"/>
        <joint name="joint1" class="size1"/>
        <geom class="visual" mesh="link1"/>
        <geom class="collision" fromto="0 0 -0.065 0 0 0" size="0.05"/>
        <body name="link2" quat="1 -1 0 0">
          <inertial pos="0.00022 -0.12856 0.01735" quat="0.50198 0.86483 -0.00778841 0.00483285" mass="1.869"
            diaginertia="0.00959898 0.00937717 0.00201315"/>
          <joint name="joint2" range="-2.059 2.0944" class="size1"/>
          <geom class="visual" mesh="link2"/>
          <geom class="collision" fromto="0 0 0.06 0 -0.17 0.03" size="0.06"/>
          <body name="link3" pos="0 -0.293 0" quat="1 1 0 0">
            <inertial pos="0.0466 -0.02463 -0.00768" quat="0.913819 0.289775 0.281481 -0.0416455" mass="1.6383"
              diaginertia="0.00351721 0.00294089 0.00195868"/>
            <joint name="joint3" class="size2"/>
            <geom class="visual" mesh="link3"/>
            <geom class="collision" fromto="0 0 -0.09 0.045 0 0" size="0.05"/>
            <body name="link4" pos="0.0525 0 0" quat="1 1 0 0">
              <inertial pos="0.07047 -0.11575 0.012" quat="0.422108 0.852026 -0.126025 0.282832" mass="1.7269"
                diaginertia="0.00657137 0.00647948 0.00186763"/>
              <joint name="joint4" range="-0.19198 3.927" class="size2"/>
              <geom class="visual" mesh="link4"/>
              <geom name="link4_c0" class="collision" fromto="0 0 0.045 0 0 0.065" size="0.043"/>
              <geom name="link4_c1" class="collision" fromto="0 0 0.065 0.0775 -0.085 0.064" size="0.042"/>
              <geom name="link4_c2" class="collision" fromto="0.0775 -0.085 0 0.0775 -0.085 0.064" size="0.042"/>
              <geom name="link4_c3" class="collision" fromto="0.0775 -0.085 0 0.0775 -0.165 0" size="0.042"/>
              <body name="link5" pos="0.0775 -0.3425 0" quat="1 1 0 0">
                <inertial pos="-0.00032 0.01604 -0.026" quat="0.999311 -0.0304457 0.000577067 0.0212082" mass="1.3203"
                  diaginertia="0.00534729 0.00499076 0.0013489"/>
                <joint name="joint5" class="size2"/>
                <geom class="visual" mesh="link5"/>
                <geom name="link5_c1" class="collision" fromto="0 0 -0.17 0 0 -0.13" size="0.042"/>
                <geom name="link5_c2" class="collision" fromto="0 0 -0.13 0 0.045 -0.085" size="0.04"/>
                <geom name="link5_c3" class="collision" fromto="0 0.045 -0.085 0 0.045 0" size="0.04"/>
                <body name="link6" quat="1 1 0 0">
                  <inertial pos="0.06469 0.03278 0.02141" quat="-0.217672 0.772419 0.16258 0.574069" mass="1.325"
                    diaginertia="0.00245421 0.00221646 0.00107273"/>
                  <joint name="joint6" range="-1.69297 3.14159" class="size3"/>
                  <geom class="visual" mesh="link6"/>
                  <geom name="link6_c1" class="collision" fromto="0 0 0.02 0.076 0 0" size="0.037"/>
                  <geom name="link6_c2" class="collision" fromto="0.076 0 0 0.076 0.035 0" size="0.037"/>
                  <body name="link7" pos="0.076 0.097 0" quat="1 -1 0 0">
                    <inertial pos="0 -0.00677 -0.01098" quat="0.487612 0.512088 -0.512088 0.487612" mass="0.17"
                      diaginertia="0.000132176 9.3e-05 5.85236e-05"/>
                    <joint name="joint7" class="size3"/>
                    <geom class="visual" material="gray" mesh="end_tool"/>
                    <geom name="flange" class="collision" type="cylinder" size="0.0375 0.0135" pos="0 0 -0.0135"/>
                    <site name="attachment_site"/>
                    <!-- Plate normal is link7 +y, the axis WACL's AxisCone keeps within 25 deg of world +z. -->
                    <geom name="plate_grip" class="collision" type="box" size="0.02 0.012 0.02" pos="0 0 0.02"
                      mass="0.1" material="gray" group="2" rgba="0.753 0.753 0.753 1"/>
                    <geom name="plate" class="collision" type="cylinder" size="0.09 0.004" pos="0 0 0.12"
                      quat="1 1 0 0" mass="0.25" material="plate" group="2" rgba="0.2 0.45 0.8 1"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="act1" joint="joint1" class="size1"/>
    <general name="act2" joint="joint2" class="size1" ctrlrange="-2.059 2.0944"/>
    <general name="act3" joint="joint3" class="size2"/>
    <general name="act4" joint="joint4" class="size2" ctrlrange="-0.19198 3.927"/>
    <general name="act5" joint="joint5" class="size2"/>
    <general name="act6" joint="joint6" class="size3" ctrlrange="-1.69297 3.14159"/>
    <general name="act7" joint="joint7" class="size3"/>
  </actuator>
</mujoco>
