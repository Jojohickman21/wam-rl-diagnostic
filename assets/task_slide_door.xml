<!--
  T1 sliding door. The panel slides along the fixture's x axis (yaw 65 degrees, tangent to the
  forearm's base-yaw sweep). Joint position p is the panel's offset from closed: p = 0 closed,
  p < 0 open. A vertical handle bar stands 7 cm proud of the panel on the robot's side; pushing the
  panel face only gives friction along the slide, so the bar is what the forearm pushes.
  Joint damping is about mass / 0.02 s, so the object stops within about one control step
  once pushing stops, as the hinged door does (REWARD_DESIGN.md exploit 3); with light damping
  it coasts for ~20 steps and a single hit can close it.
-->
<mujoco model="task_slide_door">
  <include file="task_common.xml"/>
  <worldbody>
    <body name="fixture" pos="0.51 0.09 0.45" euler="0 0 1.1345">
      <geom name="track" class="env" type="box" size="0.45 0.03 0.01" pos="0.0 -0.07 -0.27" material="wood"/>
      <body name="mover">
        <joint name="slide" type="slide" axis="1 0 0" range="-0.45 0" damping="150" frictionloss="2" armature="0.01"/>
        <geom name="panel" class="env" type="box" size="0.2 0.01 0.25" pos="0.18 -0.07 0" mass="3" material="door"/>
        <geom name="bar" class="env" type="capsule" fromto="0 0 -0.15 0 0 0.15" size="0.015" mass="0.2" material="metal"/>
        <geom name="bar_post_top" class="env" type="box" size="0.01 0.035 0.01" pos="0 -0.035 0.14" mass="0.05" material="metal"/>
        <geom name="bar_post_bottom" class="env" type="box" size="0.01 0.035 0.01" pos="0 -0.035 -0.14" mass="0.05" material="metal"/>
        <site name="push_point" pos="0 0 0" size="0.01"/>
      </body>
    </body>
  </worldbody>
  <keyframe>
    <key name="home" qpos="-0.75 1.0 0 2.5708 -1.5708 1.925 0  -0.25" ctrl="-0.75 1.0 0 2.5708 -1.5708 1.925 0"/>
  </keyframe>
</mujoco>
